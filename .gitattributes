# .gitattributes — Controle de exportação e atributos de repositório
# Garante que 'Download ZIP' do GitHub e 'git archive' exportem apenas código leve

# Ignora imagens pesadas e binários no download ZIP do GitHub
assets/img/**/*.png export-ignore
assets/img/**/*.jpeg export-ignore
assets/img/**/*.jpg export-ignore
assets/img/system/*.png export-ignore
assets/img/system/*.jpeg export-ignore
assets/img/system/*.jpg export-ignore
assets/img/uploads/ export-ignore

# Ignora pastas de deploy, referências pesadas e backups
deploy/ export-ignore
docs/planos-referencia/ export-ignore
backups/ export-ignore
uploads/ export-ignore
storage/ export-ignore
*.pdf export-ignore
*.sqlite export-ignore
*.sqlite-wal export-ignore
*.sqlite-shm export-ignore
