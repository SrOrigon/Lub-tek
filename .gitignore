# Arquivos locais com chaves e credenciais — nao versionar
config.local.php
.env
.env.*
.env.local
.env.production

# Banco de dados locais
database.sqlite
database.sqlite-journal
database.sqlite-wal
database.sqlite-shm
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.lock
database.sqlite.migrate.lock
banco de dados/*.sqlite
banco de dados/*.sqlite-wal
banco de dados/*.sqlite-shm
databases/*.sqlite
databases/*.sqlite-wal
databases/*.sqlite-shm

# Backups gerados
backups/
!backups/.htaccess
!backups/manifest.json

# Uploads e Storage de tenant (manter .htaccess de proteção)
uploads/*
!uploads/.htaccess
!uploads/.gitkeep
storage/*
!storage/.htaccess
!storage/.gitkeep

# Documentos binários pesados de referência (PDFs de 30MB+ / vídeos / zips)
docs/planos-referencia/*.pdf
*.pdf
*.zip
*.tar.gz
*.tgz
*.rar
*.7z

# Deploy Hostinger (tokens / sessao TUS — nunca versionar)
deploy/.tus_session.json
deploy/.deploy_token
deploy/hostinger_apply_sync.php
deploy/*.zip
deploy/hostinger-sync/
deploy/hostinger-includes-fix/
deploy/lubteksystem-production/
deploy/*
!deploy/.gitkeep
!deploy/*.ps1

# Fixtures HTML locais de preview
data/test_*.html

# Dados de sessao e caches temporarios de IA
data/users.json
data/sessions/*
!data/sessions/.htaccess
!data/sessions/.gitkeep
data/ai_cache/*
!data/ai_cache/.htaccess
!data/ai_cache/.gitkeep

# Dependências de terceiros
node_modules/
vendor/

# Logs de debug locais e temporários
debug-*.log
*.log
*.tmp
*.cache

# Arquivos de sistema e IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
