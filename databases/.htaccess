# Pasta legada — mesma proteção que banco de dados/
Require all denied

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

Options -Indexes

<FilesMatch "\.(sqlite|sqlite-wal|sqlite-shm|db)$">
    Require all denied
</FilesMatch>
