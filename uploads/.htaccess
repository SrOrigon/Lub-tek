# Permite servir arquivos de upload, bloqueia execução de scripts
<FilesMatch "\.(php|phtml|php3|php4|php5|phps|cgi|pl|py|asp|aspx)$">
    Require all denied
</FilesMatch>

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule \.(jpg|jpeg|png|webp|gif)$ ../assets/img/system/img_69581d7fcdbbf.jpeg [L]
</IfModule>
